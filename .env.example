# Copy to .env for local development. Never commit .env.
FLASK_ENV=development
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
# Leave blank for a temporary local-only key, or set a unique random value.
SECRET_KEY=
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Optional server-side chatbot integrations. Leave blank for offline fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite
HF_API_KEY=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
CHAT_TIMEOUT_SECONDS=30
